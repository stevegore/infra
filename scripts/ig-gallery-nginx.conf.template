set_real_ip_from 172.16.0.0/12;
real_ip_header X-Forwarded-For;
real_ip_recursive off;
map_hash_bucket_size 128;

geo $gallery_admin_ip {
    default         0;
    172.16.0.0/12   1;
    192.168.0.0/16  1;
    100.64.0.0/10   1;
    ${GALLERY_ADMIN_IP}   1;
}

map $arg_key $gallery_admin_key {
    default                0;
    ""                     0;
    "${GALLERY_ADMIN_KEY}" 1;
}

map $gallery_admin_ip$gallery_admin_key $gallery_admin {
    "00"    0;
    default 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /admin {
        return 302 /admin.html$is_args$args;
    }

    location = /admin.html {
        if ($gallery_admin = 0) {
            return 404;
        }
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        if ($gallery_admin = 0) {
            return 404;
        }
        proxy_pass http://gallery-admin:8080;
        proxy_set_header X-Gallery-Auth ok;
    }

    location = /hidden.css {
        alias /state/hidden.css;
        default_type text/css;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
